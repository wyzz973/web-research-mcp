{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceMetadata",
  "description": "Display metadata from the actual page or an explicitly marked URL-only fallback. URLs are not downloaded or certified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_url",
    "final_url",
    "canonical_url",
    "hostname",
    "domain",
    "origin",
    "display_url",
    "site_name",
    "description",
    "language",
    "favicon_url",
    "logo_url",
    "image_url",
    "published_at",
    "modified_at",
    "retrieved_at",
    "metadata_source",
    "metadata_url",
    "assets_verified",
    "provenance"
  ],
  "properties": {
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "final_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://"
    },
    "canonical_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 4096
    },
    "hostname": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "format": "uri"
    },
    "display_url": {
      "type": "string"
    },
    "site_name": {
      "type": "string",
      "maxLength": 300
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "language": {
      "type": ["string", "null"],
      "maxLength": 64
    },
    "favicon_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 4096
    },
    "logo_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 4096
    },
    "image_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 4096
    },
    "published_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "modified_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "metadata_source": {
      "enum": ["url_only", "html"]
    },
    "metadata_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://"
    },
    "assets_verified": {
      "const": false
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_name", "favicon_url", "logo_url", "image_url", "canonical_url"],
      "properties": {
        "site_name": {
          "enum": ["hostname", "opengraph", "application_name"]
        },
        "favicon_url": {
          "enum": ["html_link", "origin_fallback", "none"]
        },
        "logo_url": {
          "enum": ["json_ld", "none"]
        },
        "image_url": {
          "enum": ["opengraph", "none"]
        },
        "canonical_url": {
          "enum": ["html_link", "none"]
        }
      }
    }
  }
}
