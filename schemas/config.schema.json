{
  "type": "object",
  "additionalProperties": false,
  "required": ["transport", "search", "fetch", "ranking", "storage", "logging"],
  "properties": {
    "transport": {
      "const": "stdio"
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "base_url",
        "limit",
        "deadline_ms",
        "provider_timeout_ms",
        "cache_ttl_seconds",
        "upstream_policy",
        "engine_allowlist",
        "evidence",
        "scope",
        "retrieval"
      ],
      "properties": {
        "provider": {
          "const": "searxng"
        },
        "base_url": {
          "type": ["string", "null"]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1
        },
        "provider_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "cache_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "upstream_policy": {
          "const": {
            "access_mode": "public-anonymous",
            "requires_account": false,
            "requires_api_key": false,
            "requires_payment": false,
            "allow_keyed_fallback": false,
            "allow_paid_proxy_dependency": false
          }
        },
        "engine_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default_mode",
            "default_max_results",
            "max_results",
            "max_passages_per_result",
            "max_chars_per_passage",
            "total_deadline_ms"
          ],
          "properties": {
            "default_mode": {
              "const": "none"
            },
            "default_max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "max_passages_per_result": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "max_chars_per_passage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 800
            },
            "total_deadline_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include_subdomains", "max_sites"],
          "properties": {
            "include_subdomains": {
              "type": "boolean"
            },
            "max_sites": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_upstream_requests", "max_pages_per_query", "max_candidates"],
          "properties": {
            "max_upstream_requests": {
              "type": "integer",
              "minimum": 1
            },
            "max_pages_per_query": {
              "type": "integer",
              "minimum": 1
            },
            "max_candidates": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deadline_ms",
        "max_redirects",
        "max_decompressed_bytes",
        "max_chars",
        "per_host_concurrency",
        "public_urls_only",
        "respect_robots",
        "browser_fallback",
        "global_concurrency",
        "parser_worker_concurrency",
        "parser_timeout_ms",
        "max_compressed_bytes",
        "max_output_chars",
        "allow_https_downgrade",
        "parser_memory_mb",
        "user_agent"
      ],
      "properties": {
        "deadline_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_redirects": {
          "type": "integer",
          "minimum": 1
        },
        "max_decompressed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "per_host_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "public_urls_only": {
          "const": true
        },
        "respect_robots": {
          "const": true
        },
        "browser_fallback": {
          "const": false
        },
        "global_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "parser_worker_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "parser_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_compressed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "allow_https_downgrade": {
          "const": false
        },
        "parser_memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "user_agent": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "rrf_enabled",
        "rrf_k",
        "embeddings_enabled",
        "reranker_enabled",
        "relevance_method",
        "confidence_method"
      ],
      "properties": {
        "mode": {
          "const": "upstream"
        },
        "rrf_enabled": {
          "const": false
        },
        "rrf_k": {
          "type": "integer",
          "minimum": 1
        },
        "embeddings_enabled": {
          "const": false
        },
        "reranker_enabled": {
          "const": false
        },
        "relevance_method": {
          "const": "lexical_coverage_v1"
        },
        "confidence_method": {
          "const": "traceability_v1"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "snapshot_ttl_seconds", "max_bytes"],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "include_query_text"],
      "properties": {
        "stream": {
          "const": "stderr"
        },
        "include_query_text": {
          "const": false
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeConfiguration"
}
