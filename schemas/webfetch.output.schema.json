{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "webfetch.output",
  "description": "Versioned MCP business contract. Runtime validation is authoritative for external JSON.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.3-draft"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["ok", "partial", "error"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "CONFIGURATION_REQUIRED",
                "RATE_LIMITED",
                "UPSTREAM_BLOCKED",
                "UPSTREAM_UNAVAILABLE",
                "TIMEOUT",
                "FETCH_BLOCKED",
                "ROBOTS_DENIED",
                "UNSUPPORTED_CONTENT_TYPE",
                "RESPONSE_TOO_LARGE",
                "EXTRACTION_FAILED",
                "CURSOR_EXPIRED",
                "CURSOR_MISMATCH",
                "HTTP_ERROR",
                "CANCELLED",
                "STORAGE_UNAVAILABLE",
                "INTERNAL_ERROR",
                "INVALID_ARGUMENT",
                "SEARCH_BUDGET_EXHAUSTED"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "retry_after_ms": {
              "type": "integer",
              "minimum": 0
            },
            "http_status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          },
          "required": ["code", "message", "retryable"],
          "additionalProperties": false
        }
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "final_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "title": {
      "type": "string"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_type": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "start_char": {
            "type": "integer",
            "minimum": 0
          },
          "end_char": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["id", "text", "start_char", "end_char"],
        "additionalProperties": false
      }
    },
    "truncated": {
      "type": "boolean",
      "description": "True only when more snapshot content remains after this page; the final page is false even when its start offset is nonzero."
    },
    "next_cursor": {
      "type": ["string", "null"]
    },
    "view": {
      "enum": ["document", "evidence"]
    },
    "source_metadata": {
      "$ref": "#/$defs/source_metadata"
    },
    "evidence": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "has_more_evidence": {
      "type": "boolean"
    },
    "next_evidence_cursor": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "evidence_chars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8000
    },
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "Optional local execution trace identifier. No hosted tracing account is required."
    }
  },
  "required": ["schema_version", "request_id", "status", "warnings", "error"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "CONFIGURATION_REQUIRED",
                  "RATE_LIMITED",
                  "UPSTREAM_BLOCKED",
                  "UPSTREAM_UNAVAILABLE",
                  "TIMEOUT",
                  "FETCH_BLOCKED",
                  "ROBOTS_DENIED",
                  "UNSUPPORTED_CONTENT_TYPE",
                  "RESPONSE_TOO_LARGE",
                  "EXTRACTION_FAILED",
                  "CURSOR_EXPIRED",
                  "CURSOR_MISMATCH",
                  "HTTP_ERROR",
                  "CANCELLED",
                  "STORAGE_UNAVAILABLE",
                  "INTERNAL_ERROR",
                  "INVALID_ARGUMENT",
                  "SEARCH_BUDGET_EXHAUSTED"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "retry_after_ms": {
                "type": "integer",
                "minimum": 0
              },
              "http_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            },
            "required": ["code", "message", "retryable"],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "required": [
          "source_id",
          "snapshot_id",
          "url",
          "final_url",
          "title",
          "fetched_at",
          "content_type",
          "content",
          "content_sha256",
          "segments",
          "truncated",
          "next_cursor",
          "view",
          "source_metadata",
          "evidence",
          "has_more_evidence",
          "next_evidence_cursor",
          "evidence_chars"
        ],
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "warnings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "truncated": {
            "const": true
          }
        },
        "required": ["truncated"]
      },
      "then": {
        "properties": {
          "next_cursor": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "truncated": {
            "const": false
          }
        },
        "required": ["truncated"]
      },
      "then": {
        "properties": {
          "next_cursor": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "view": {
            "const": "document"
          }
        },
        "required": ["view"]
      },
      "then": {
        "properties": {
          "evidence": {
            "maxItems": 0
          },
          "has_more_evidence": {
            "const": false
          },
          "next_evidence_cursor": {
            "type": "null"
          },
          "evidence_chars": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "view": {
            "const": "evidence"
          }
        },
        "required": ["view"]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "has_more_evidence": {
            "const": true
          }
        },
        "required": ["has_more_evidence"]
      },
      "then": {
        "properties": {
          "next_evidence_cursor": {
            "type": "string",
            "minLength": 1
          },
          "truncated": {
            "const": true
          },
          "view": {
            "const": "evidence"
          }
        }
      },
      "else": {
        "properties": {
          "next_evidence_cursor": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "relevance": {
      "type": "object",
      "properties": {
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "enum": ["lexical_coverage_v1", "none"]
        },
        "version": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "basis": {
          "enum": ["title_snippet", "quote"]
        },
        "matched_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["score", "method", "version", "basis", "matched_terms", "reasons"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              },
              "version": {
                "type": "null"
              },
              "matched_terms": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "number"
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_format": {
          "const": "text"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 1
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "extractor_version": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_cursor": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "const": "exact_match"
        },
        "relevance": {
          "$ref": "#/$defs/relevance",
          "properties": {
            "basis": {
              "const": "quote"
            }
          }
        },
        "segment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selection_method": {
          "const": "paragraph_context_v2"
        }
      },
      "required": [
        "id",
        "quote",
        "url",
        "snapshot_id",
        "snapshot_format",
        "content_sha256",
        "segment_id",
        "start_char",
        "end_char",
        "fetched_at",
        "expires_at",
        "extractor_version",
        "snapshot_cursor",
        "verification",
        "relevance",
        "segment_ids",
        "selection_method"
      ],
      "additionalProperties": false
    },
    "source_metadata": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SourceMetadata",
      "description": "Display metadata from the actual page or an explicitly marked URL-only fallback. URLs are not downloaded or certified.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "final_url",
        "canonical_url",
        "hostname",
        "domain",
        "origin",
        "display_url",
        "site_name",
        "description",
        "language",
        "favicon_url",
        "logo_url",
        "image_url",
        "published_at",
        "modified_at",
        "retrieved_at",
        "metadata_source",
        "metadata_url",
        "assets_verified",
        "provenance"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "final_url": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https?://"
        },
        "canonical_url": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 4096
        },
        "hostname": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "display_url": {
          "type": "string"
        },
        "site_name": {
          "type": "string",
          "maxLength": 300
        },
        "description": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "language": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "favicon_url": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 4096
        },
        "logo_url": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 4096
        },
        "image_url": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 4096
        },
        "published_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "modified_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "retrieved_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "metadata_source": {
          "enum": ["url_only", "html"]
        },
        "metadata_url": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https?://"
        },
        "assets_verified": {
          "const": false
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["site_name", "favicon_url", "logo_url", "image_url", "canonical_url"],
          "properties": {
            "site_name": {
              "enum": ["hostname", "opengraph", "application_name"]
            },
            "favicon_url": {
              "enum": ["html_link", "origin_fallback", "none"]
            },
            "logo_url": {
              "enum": ["json_ld", "none"]
            },
            "image_url": {
              "enum": ["opengraph", "none"]
            },
            "canonical_url": {
              "enum": ["html_link", "none"]
            }
          }
        }
      }
    }
  }
}
