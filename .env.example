# Reference list of every setting. The program reads the process environment only; it does not
# load .env files. Export these in your shell, or put them in the "env" block of your MCP client's
# server entry. All of them are optional: without any key the anonymous free tiers of Exa,
# Parallel and Tavily are used.

# EXA_API_KEY=
# PARALLEL_API_KEY=
# TAVILY_API_KEY=

# Set to 0 to stop sending queries to anonymous public endpoints.
# WEB_RESEARCH_ANONYMOUS_SOURCES=1
# Self-imposed daily ceiling per anonymous source.
# WEB_RESEARCH_ANONYMOUS_DAILY_CAP=100
# Stop using paid sources once the estimated spend for the day reaches this amount (USD).
# WEB_RESEARCH_DAILY_BUDGET_USD=1

# Output ceilings for one tool response. Raise them only if your harness accepts larger tool output.
# WEB_RESEARCH_MAX_OUTPUT_TOKENS=10000
# WEB_RESEARCH_MAX_OUTPUT_CHARS=30000

# "text" (default) returns the model-facing text view; "json" returns the result object.
# WEB_RESEARCH_MCP_OUTPUT=text
# WEB_RESEARCH_DATA_DIR=
# Sent with every request so that site owners and vendors can tell who is calling.
# WEB_RESEARCH_USER_AGENT=web-research-mcp/2.0 (+https://github.com/wyzz973/web-research-mcp)
