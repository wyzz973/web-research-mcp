{
  "transport": "stdio",
  "search": {
    "provider": "searxng",
    "base_url": null,
    "limit": 8,
    "deadline_ms": 15000,
    "provider_timeout_ms": 8000,
    "cache_ttl_seconds": 300,
    "upstream_policy": {
      "access_mode": "public-anonymous",
      "requires_account": false,
      "requires_api_key": false,
      "requires_payment": false,
      "allow_keyed_fallback": false,
      "allow_paid_proxy_dependency": false
    },
    "engine_allowlist": [],
    "evidence": {
      "default_mode": "none",
      "default_max_results": 3,
      "max_results": 5,
      "max_passages_per_result": 3,
      "max_chars_per_passage": 1600,
      "total_deadline_ms": 45000,
      "max_chars_per_result": 4000,
      "max_candidate_passages": 32
    },
    "scope": {
      "include_subdomains": true,
      "max_sites": 20
    },
    "retrieval": {
      "max_upstream_requests": 4,
      "max_pages_per_query": 2,
      "max_candidates": 80
    }
  },
  "fetch": {
    "deadline_ms": 20000,
    "max_redirects": 5,
    "max_decompressed_bytes": 5242880,
    "max_chars": 12000,
    "per_host_concurrency": 2,
    "public_urls_only": true,
    "respect_robots": true,
    "browser_fallback": false,
    "global_concurrency": 8,
    "parser_worker_concurrency": 2,
    "parser_timeout_ms": 5000,
    "max_compressed_bytes": 5242880,
    "max_output_chars": 50000,
    "allow_https_downgrade": false,
    "parser_memory_mb": 128,
    "user_agent": "web-research-mcp/0.1 (+https://github.com/wyzz973/web-research-mcp)"
  },
  "ranking": {
    "mode": "upstream",
    "rrf_enabled": false,
    "rrf_k": 60,
    "embeddings_enabled": false,
    "reranker_enabled": false,
    "relevance_method": "lexical_coverage_v1",
    "confidence_method": "traceability_v1"
  },
  "storage": {
    "directory": "./data",
    "snapshot_ttl_seconds": 86400,
    "max_bytes": 268435456
  },
  "logging": {
    "stream": "stderr",
    "include_query_text": false
  },
  "observability": {
    "enabled": true,
    "capture_content": false
  }
}
